{
  "name": "dua-language",
  "displayName": "Dua Language",
  "description": "Syntax highlighting, completions, snippets and diagnostics for the Dua scripting language.",
  "version": "0.3.0",
  "publisher": "dua-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zero-error-no-warning/dua.git",
    "directory": "editors/vscode-dua"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dua"
  ],
  "scripts": {
    "build:checker": "node scripts/build-checker.js",
    "test": "node --test test/*.test.js",
    "package": "npm run build:checker && vsce package --target win32-x64"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dua",
    "syntax highlighting",
    "embedded scripting"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Completions and highlighting are available; diagnostics require workspace trust."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Dua",
      "properties": {
        "dua.completion.metadataFiles": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".dua-completion.json"],
          "description": "Workspace-relative host API completion catalogs. Only JSON is read; host scripts are never executed."
        },
        "dua.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show syntax and static type errors while editing Dua files."
        },
        "dua.diagnostics.delay": {
          "type": "integer",
          "default": 400,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay in milliseconds before checking an edited document."
        },
        "dua.checkerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Absolute path to a dua-check executable. Empty uses the bundled checker."
        }
      }
    },
    "snippets": [
      {
        "language": "dua",
        "path": "./snippets/dua.json"
      }
    ],
    "languages": [
      {
        "id": "dua",
        "aliases": [
          "Dua",
          "dua"
        ],
        "extensions": [
          ".dua"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dua",
        "scopeName": "source.dua",
        "path": "./syntaxes/dua.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
