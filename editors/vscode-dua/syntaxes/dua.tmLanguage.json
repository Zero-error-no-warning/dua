{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dua",
  "scopeName": "source.dua",
  "patterns": [
    { "include": "#comments" },
    { "include": "#interpolated-string" },
    { "include": "#string" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#function-declaration" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dua",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.dua",
          "match": "//.*$"
        },
        {
          "name": "comment.block.dua",
          "begin": "/\\+",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.dua" } },
          "end": "\\+/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.dua" } },
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "interpolated-string": {
      "name": "string.quoted.double.interpolated.dua",
      "begin": "\\bi(\")",
      "beginCaptures": {
        "0": { "name": "storage.type.string.dua" },
        "1": { "name": "punctuation.definition.string.begin.dua" }
      },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.dua" } },
      "patterns": [
        {
          "name": "constant.character.escape.dua",
          "match": "\\$\\$"
        },
        {
          "name": "meta.interpolation.dua",
          "begin": "\\$\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.dua" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.dua" } },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.dua",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dua" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.dua" } }
    },
    "numbers": {
      "name": "constant.numeric.dua",
      "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d+|\\d+)(?![A-Za-z0-9_])"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dua",
          "match": "\\b(?:try|catch|return|if|else|while|for|foreach|switch|case|default|break|continue|yield|import|export|as)\\b"
        },
        {
          "name": "storage.type.dua",
          "match": "\\b(?:auto|delegate|alias|table|struct)\\b"
        },
        {
          "name": "keyword.operator.word.dua",
          "match": "\\bis\\b"
        },
        {
          "name": "constant.language.dua",
          "match": "\\b(?:true|false|null|this)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.dua",
      "match": "\\b(?:any|bool|double|int|string|void)\\b"
    },
    "function-declaration": {
      "name": "meta.function.dua",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+(?!delegate\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.type.return.dua" },
        "2": { "name": "entity.name.function.dua" }
      }
    },
    "function-call": {
      "name": "entity.name.function.call.dua",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.dua",
      "match": "(?:=>|:>|\\.\\.\\.|\\.\\.|==|!=|<=|>=|<<|>>|&&|\\|\\||[+\\-*/%$~!<>=?:&|^])"
    }
  }
}
